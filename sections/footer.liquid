<footer id="footer" class="fg-footer-redesign" style="display: block !important; visibility: visible !important; opacity: 1 !important; width: 100%; height: auto">
  <div class="fg-footer-main">
    <div class="uk-container">
      {% include 'responsive-footer-desktop' %}
      {% include 'responsive-footer-mobile' %}
    </div>
  </div>
  <div class="fg-footer-bottom uk-text-center">
    <small>{{ 'layout.footer.copyright' | t }} &copy; all rights reserved {{ 'now' | date: "%Y" }}, <a href="/">{{ shop.name | replace: 'Firgelli', 'FIRGELLI' }}</a>.</small>
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "max_blocks": 3,
    "settings": [
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "background_color",
        "label": "Background Brand Color",
        "info" : "Defaults to primary muted grey colour"
      }
    ],
    "blocks" : [
      {
        "type": "select",
        "name": "Add Link List",
        "settings": [
          {
            "type": "link_list",
            "id": "linklist",
            "label": "Footer Menu"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Footer",
        "category": "Global"
      }
    ]
  }

{% endschema %}
