<script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>  
<script>
function isChecked(...selectors){
  return selectors.some(selector => {
    return document.querySelector(selector)?.checked;
  });
}
document.querySelectorAll('.uk-checkbox').forEach(function(checkbox){
  checkbox.checked = false;
});
document.querySelectorAll('.custom-range-slider .custom-range-slider__track').forEach(function(slider) {
  const sliderContainer = slider.closest('.custom-range-slider');
  const inputs = [
    sliderContainer.querySelector('.custom-range-slider__input--from'),
    sliderContainer.querySelector('.custom-range-slider__input--to')
  ];
  let sliderMax = 60;
  let startOne = 1;
  let stepOne = 1;
  let startTwo = 10;
  let stepTwo = 1;
  if (slider.id.includes('Stroke')){
    sliderMax = 60;
  }
  else if (slider.id.includes('Force')){
    sliderMax = 2200;
    startOne = 20;
    stepOne = 0.5;
    startTwo = 350;
    stepTwo = 100;
  }

    noUiSlider.create(slider, {
        start: [0, sliderMax],
        connect: true,
        range: {
            'min': 0,
            'max': sliderMax,
            '10%': [startOne],
            '50%': [startTwo]
        },
        pips: {mode: 'count', values: 4}
      	
    });
    
    
    slider.noUiSlider.on('update', function(values, handle) {
        inputs[handle].value = parseInt(values[handle]);
    });
  
  	slider.noUiSlider.on('set', function(values, handle){
      //checkStroke(rangeSliderInputs[0][0].value, rangeSliderInputs[0][1].value);
      updateFilterCount();
      filter();
    });
  
  	slider.noUiSlider.on('slide', function(values, handle){
      updateFilterCount();
      filter();
    });

    function setSliderHandle(i, value) {
        var r = [null,null];
        r[i] = value;
        slider.noUiSlider.set(r);
    }

      inputs.forEach(function(input, handle) {
        input.addEventListener('change', function(){
            setSliderHandle(handle, this.value);
        });
      


        input.addEventListener('keydown', function(e) {

            var values = slider.noUiSlider.get();
            var value = Number(values[handle]);

            // [[handle0_down, handle0_up], [handle1_down, handle1_up]]
            var steps = slider.noUiSlider.steps();

            // [down, up]
            var step = steps[handle];

            var position;

            // 13 is enter,
            // 38 is key up,
            // 40 is key down.
            switch (e.which) {

                case 13:
                    setSliderHandle(handle, this.value);
                    break;

                case 38:

                    // Get step to go increase slider value (up)
                    position = step[1];

                    // false = no step is set
                    if ( position === false ) {
                        position = 1;
                    }

                    // null = edge of slider
                    if ( position !== null ) {
                        setSliderHandle(handle, value + position);
                    }

                    break;

                case 40:

                    position = step[0];

                    if ( position === false ) {
                        position = 1;
                    }

                    if ( position !== null ) {
                        setSliderHandle(handle, value - position);
                    }

                    break;
            }
        });
    });
});  
document.addEventListener('DOMContentLoaded', function(){

  // Reset all checkboxes
  document.querySelectorAll('.uk-checkbox').forEach(function(checkbox){
    checkbox.checked = false;
  });


  // Reset all sliders
  document.querySelectorAll('.custom-range-slider__track').forEach(function(slider){

    if(!slider.noUiSlider) return;

    let maxValue = slider.id.includes('Force') ? 2200 : 60;

    slider.noUiSlider.set([
      0,
      maxValue
    ]);

  });


  // Update filter count
  updateFilterCount();


  // Apply filter with defaults
  if(lines.length){
    filter();
  }

});
document.addEventListener('DOMContentLoaded',()=>{

    $.ajax({
        type: "GET",
        url: '{{ 'final_widget_data_2.csv' | asset_url }}',
        dataType: "text",
        success: function(data) {processData(data);}
     });
  });
var lines = [];

function processData(allText) {

  Papa.parse(allText, {
    header: true,
    skipEmptyLines: true,

    complete: function(results) {

    lines = results.data
  .filter(product => {
    return document.getElementById(product.URL);
  })
  .map(product => ({
    strokes: product.Stroke.split('_').map(Number),
    voltage12: product["12v"],
    voltage24: product["24v"],
    feedback: product.Sensor,
    force: Number(product.Force),
    type: product.Type,
    handle: product.URL
  }));


// RESET FILTERS HERE

document.querySelectorAll('.uk-checkbox').forEach(function(checkbox){
  checkbox.checked = false;
});


document.querySelectorAll('.custom-range-slider__track').forEach(function(slider){

  if(!slider.noUiSlider) return;

  slider.noUiSlider.set([
    0,
    slider.id.includes('Force') ? 2200 : 60
  ]);

});


updateFilterCount();

filter();

}

  });

}
  
  
function filter(){

 const strokeSliders = [
    document.getElementById('StrokeSlider'),
    document.getElementById('StickyStrokeSlider'),
    document.getElementById('MobileStrokeSlider')
  ].filter(slider => slider && slider.noUiSlider);


  const forceSliders = [
    document.getElementById('SidebarForceSlider'),
    document.getElementById('StickyForceSlider'),
    document.getElementById('MobileForceSlider')
  ].filter(slider => slider && slider.noUiSlider);


  if(!strokeSliders.length || !forceSliders.length){
    return;
  }

  let minStroke = Math.max(
      ...strokeSliders.map(slider => Number(slider.noUiSlider.get()[0]))
  );

  let maxStroke = Math.min(
      ...strokeSliders.map(slider => Number(slider.noUiSlider.get()[1]))
  );


  let minForce = Math.max(
      ...forceSliders.map(slider => Number(slider.noUiSlider.get()[0]))
  );

  let maxForce = Math.min(
      ...forceSliders.map(slider => Number(slider.noUiSlider.get()[1]))
  );

  const voltageSelected = [];

  if(isChecked('#Sidebar12v','#Sticky12v','#Mobile12v')){
      voltageSelected.push('12v');
  }

  if(isChecked('#Sidebar24v','#Sticky24v','#Mobile24v')){
      voltageSelected.push('24v');
  }



const typesSelected = [];

['Rod','Track','Column'].forEach(function(value){

    if(
        isChecked(
            '#Sidebar'+value,
            '#Sticky'+value,
            '#Mobile'+value
        )
    ){
        typesSelected.push(value);
    }

});



const yesSelected = isChecked(
    '#SidebarYes',
    '#StickyYes',
    '#MobileYes'
);


const noSelected = isChecked(
    '#SidebarNo',
    '#StickyNo',
    '#MobileNo'
);



  for(let i = 0; i < lines.length; i++){

    let product = lines[i];
    let productHandle = product.handle;
    let force = product.force;
    let voltage12 = product.voltage12;
    let voltage24 = product.voltage24;
    let type = product.type;
    let hasYesNo = product.feedback;


      let visible = true;


      // FORCE CHECK
      if(force < minForce || force > maxForce){
          visible = false;
      }


      

      
      if(voltageSelected.length){

          if(
              !(
                  (voltageSelected.includes('12v') && voltage12 === '12v') ||
                  (voltageSelected.includes('24v') && voltage24 === '24v')
              )
          ){
              visible = false;
          }

      }



 


      if(
          typesSelected.length &&
          !typesSelected.includes(type)
      ){
          visible = false;
      }

      if(yesSelected && !noSelected && hasYesNo === ''){
          visible = false;
      }

      if(noSelected && !yesSelected && hasYesNo !== ''){
          visible = false;
      }

      let strokes = product.strokes;

      let strokeMatch = strokes.some(function(stroke){

          let value = Number(stroke);

          return value >= minStroke && value <= maxStroke;
      });
      if(!strokeMatch){
          visible = false;
      }
      if(visible){
          showProduct(productHandle);
      }
      else{
          hideProduct(productHandle);
      }
    }
    updateFilterCount();
  }
  function hideProduct(handle){
    const wrapper = document.getElementById(handle)?.closest('.productMainDiv');
    if(wrapper) wrapper.setAttribute("hidden","hidden");
  }

  function showProduct(handle){
    const wrapper = document.getElementById(handle)?.closest('.productMainDiv');
    if(wrapper) wrapper.removeAttribute("hidden");
  }

  function submitFunction(){
    filter();
  }

</script>
<script>
var count = 0;
document.querySelectorAll('.js-card-filter').forEach(card => {
  count++;
  card.setAttribute('count', count);
  const priceElement = card.querySelector('.fg-card__body-price-text_num');
  if (priceElement) {
      const priceText = priceElement.innerHTML.trim();
      const priceValue = priceText.replace('$', '').replace('USD','');
      card.setAttribute('price', priceValue);
  }
  const parentUl = card.querySelector('.fg-card__option-list');
  const liElements = parentUl.querySelectorAll('.optionElement');
  let forceElement = null;
  let strokeElement = null;
  for (let i = 0; i < liElements.length; i++) {
    const li = liElements[i];
    if (li.innerHTML.trim().startsWith('Force')) {
      forceElement = li;
    }
    else if (li.innerHTML.trim().startsWith('Stroke')) {
      strokeElement = li;
    }
  }
  if (forceElement) {
    const forceText = forceElement.textContent.trim();
    const forceValues = forceText.match(/(\d+)(?:–(\d+))?/);
    if (forceValues) {
      card.setAttribute('lowerForce', forceValues[1]);
      card.setAttribute('higherForce', forceValues[2] ? forceValues[2] : forceValues[1]);
    }
  }
  if(strokeElement){
    const strokeText = strokeElement.textContent.trim();
    const strokeValues = convertToInches(strokeText);
    if (strokeValues) {
      card.setAttribute('lowerStroke', strokeValues.lower);
      card.setAttribute('higherStroke', strokeValues.higher);
    }
  }
});


function convertToInches(strokeText) {
  // Updated regex to handle decimal numbers
  const match = strokeText.match(/(\d+(\.\d+)?)(?:–(\d+(\.\d+)?))?\s*(mm|inches?)?/);
  if (!match) return { lower: 0, higher: 0 };

  const value1 = parseFloat(match[1]); // First number
  const value2 = match[3] ? parseFloat(match[3]) : value1; // Second number, or same as the first if not present
  const unit = match[5]; // Unit (mm or inches)

  // Convert values to inches if they are in millimeters
  const value1Inches = unit === 'mm' ? value1 / 25.4 : value1;
  const value2Inches = unit === 'mm' ? value2 / 25.4 : value2;

  return { lower: value1Inches, higher: value2Inches };
}


