.stickyFilterDock{
  position:fixed;
  top:0;
  left:50%;
  width:100%;
  transform:translateX(-50%) translateY(-100%);
  
  background:#fff;
  border-bottom:1px solid #e7edf5;
  box-shadow:0 4px 12px rgba(15,23,42,.06);

  display:flex;
  flex-direction:column;

  align-items:stretch;

  z-index:9999;

  opacity:0;
  transition:
    transform .25s ease,
    opacity .25s ease;
}
.stickyFilterDock.visible{
  transform:translateY(0);
  opacity:1;
}
.stickyFilterDock.visible{
  transform:translateX(-50%) translateY(0);
}
.stickyFilterToggle{
  margin-left: 40px;
}
.stickySortWrapper{
  margin-right: 40px;
}
.stickyFilterToggle,
.stickySortToggle{
  height:40px;

  padding:0 16px;

  border:1px solid #dbe4f0;
  border-radius:10px;

  background:#fff;

  display:flex;
  align-items:center;
  gap:8px;

  cursor:pointer;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;

  font-weight:600;
}

.stickyFilterToggle:focus,
.stickySortToggle:focus,
.stickyFilterToggle:focus-visible,
.stickySortToggle:focus-visible{
  outline: none;
  box-shadow: none;
}

.stickyFilterSummary{
  font-size:14px;
  color:#64748b;
}






