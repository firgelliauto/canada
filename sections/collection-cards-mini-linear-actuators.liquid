function changeSort(sort){

  document.querySelectorAll('.sortText').forEach(function(element) {
    element.innerHTML = 'Sort By: ' + sort;
  });

  const container = document.getElementById('fg-collection-grid');
  const elements = Array.from(container.querySelectorAll('.productMainDiv'));

  elements.sort((a, b) => {

    const cardA = a.querySelector('.js-card-filter');
    const cardB = b.querySelector('.js-card-filter');

    if (!cardA || !cardB) return 0;

    switch(sort){

      case "Force Low to High":
        return parseFloat(cardA.getAttribute('lowerforce')) -
               parseFloat(cardB.getAttribute('lowerforce'));

      case "Force High to Low":
        return parseFloat(cardB.getAttribute('higherforce')) -
               parseFloat(cardA.getAttribute('higherforce'));

      case "Stroke Low to High":
        return parseFloat(cardA.getAttribute('lowerstroke')) -
               parseFloat(cardB.getAttribute('lowerstroke'));

      case "Stroke High to Low":
        return parseFloat(cardB.getAttribute('higherstroke')) -
               parseFloat(cardA.getAttribute('higherstroke'));

      case "Price Low to High":
        return parseFloat(cardA.getAttribute('price')) -
               parseFloat(cardB.getAttribute('price'));

      case "Price High to Low":
        return parseFloat(cardB.getAttribute('price')) -
               parseFloat(cardA.getAttribute('price'));

      case "Featured":
      default:
        return parseInt(cardA.getAttribute('count')) -
               parseInt(cardB.getAttribute('count'));
    }
  });

  elements.forEach(element => container.appendChild(element));

  document.querySelectorAll('.dropdown-content-sort').forEach(function(dropdown) {
    dropdown.style.display = 'none';
    dropdown.classList.remove('fg-open');
  });
}





(function(){
  function closeAllSortDropdowns() {
    document.querySelectorAll('.dropdown-content-sort').forEach(function(dropdown){
      dropdown.style.display = 'none';
      dropdown.classList.remove('fg-open');
    });
  }

  function getDropdownContainer(button) {
    return button.closest('#sortButtonSidebar') || button.closest('#sortButton') || button.parentElement;
  }

  document.querySelectorAll('.sortButtonClass, .sortButtonClassSidebar').forEach(function(btn) {
    var container = getDropdownContainer(btn);
    var dropdown = container ? container.querySelector('.dropdown-content-sort') : null;
    if (!dropdown) return;

    function syncWidth() {
      dropdown.style.width = btn.getBoundingClientRect().width + 'px';
    }
    syncWidth();
    window.addEventListener('resize', syncWidth);

    btn.addEventListener('click', function(event) {
      event.stopPropagation();
      var isOpen = dropdown.style.display === 'block';
      if (isOpen) {
        dropdown.style.display = 'none';
        dropdown.classList.remove('fg-open');
      } else {
        closeAllSortDropdowns();
        syncWidth();
        dropdown.style.display = 'block';
        dropdown.classList.add('fg-open');
      }
    });

    dropdown.addEventListener('click', function(event) {
      event.stopPropagation();
    });
  });

  document.addEventListener('click', function() {
    closeAllSortDropdowns();
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') closeAllSortDropdowns();
  });
})();

document.querySelectorAll('.dropdown').forEach(function(dropdown) {
  dropdown.addEventListener('click', function() {
    const arrow = this.querySelector('.DropdownArrow');
    if (arrow) {
      arrow.classList.toggle('rotated');
    }
  });
});
document.querySelectorAll('.dropdownSidebar').forEach(function(dropdown) {
