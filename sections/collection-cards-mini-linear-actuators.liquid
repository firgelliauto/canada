    const arrow = this.querySelector('.DropdownArrow');
    if (arrow) {
      arrow.classList.toggle('rotated');
    }
  });
});

function syncSliders(ids){

 const sliders = ids
 .map(id => document.getElementById(id))
 .filter(slider => slider && slider.noUiSlider);

 let syncing = false;

 sliders.forEach(source => {

   source.noUiSlider.on('update', values => {

     if(syncing) return;

     syncing = true;

     sliders.forEach(target => {

       if(target !== source){
         target.noUiSlider.set(values, false);
       }

     });

     syncing = false;

   });

 });

}

syncSliders([
'StrokeSlider',
'StickyStrokeSlider',
'MobileStrokeSlider'
]);

syncSliders([
'SidebarForceSlider',
'StickyForceSlider',
'MobileForceSlider'
]);

function updateFilterCount(){

  let count = 0;

  function anyCheckedInGroup(group){
    return group.some(function(selectors){
      return isChecked.apply(null, selectors);
    });
  }

  // Checkbox filter groups (count once per filter column)
  if(anyCheckedInGroup([
      ['#Sidebar12v', '#Sticky12v', '#Mobile12v'],
      ['#Sidebar24v', '#Sticky24v', '#Mobile24v']
    ])) count++;

  if(anyCheckedInGroup([
      ['#SidebarRod', '#StickyRod', '#MobileRod'],
      ['#SidebarTrack', '#StickyTrack', '#MobileTrack'],
      ['#SidebarColumn', '#StickyColumn', '#MobileColumn']
    ])) count++;

  if(anyCheckedInGroup([
      ['#SidebarYes', '#StickyYes', '#MobileYes'],
      ['#SidebarNo', '#StickyNo', '#MobileNo']
    ])) count++;

  // Stroke slider
  const strokeSlider =
    document.getElementById('StrokeSlider') ||
    document.getElementById('StickyStrokeSlider') ||
    document.getElementById('MobileStrokeSlider');

  if(strokeSlider){

    const values = strokeSlider.noUiSlider.get().map(Number);

    if(values[0] !== 0 || values[1] !== 60){
      count++;
    }
  }

  // Force slider
  const forceSlider =
    document.getElementById('SidebarForceSlider') ||
    document.getElementById('StickyForceSlider') ||
    document.getElementById('MobileForceSlider');

  if(forceSlider){

    const values = forceSlider.noUiSlider.get().map(Number);

    if(values[0] !== 0 || values[1] !== 2200){
      count++;
    }
  }

  document.querySelectorAll('.stickyFilterSummary').forEach(function(el){

    el.textContent =
      count + (count === 1 ? ' Filter Applied' : ' Filters Applied');

  });

}

document.addEventListener('DOMContentLoaded',()=>{
  updateFilterCount();
  if(lines.length){
    filter();
  }
});









