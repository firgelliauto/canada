<script>

  let scrollDownHeight = 840;
  window.addEventListener('scroll', function(){
    scrollDownHeight = 840;
    if(window.innerWidth <= 970){
      scrollDownHeight = 950;
    }
    if(window.innerWidth <= 480){
      scrollDownHeight = 1050;
    }
    const stickyBar = document.getElementById('stickyFilterDock');
    if(!stickyBar){
      return;
    }
    if(window.scrollY > scrollDownHeight && !collectionOptionsAtTop){
      stickyBar.classList.add('visible');
    }  
    else {
      stickyBar.classList.remove('visible');
    }
  });

document
  .getElementById('stickyFilterButton')
  .addEventListener('click', function(){

    if(window.innerWidth <= 958){

      openMobileFilters();

    }else{

      document
        .getElementById('stickyFilterContent')
        .classList
        .toggle('open');

    }

});

document.addEventListener('DOMContentLoaded', function(){
  const mobileFiltersButton = document.getElementById('mobileFiltersButton');
  if(mobileFiltersButton){
    mobileFiltersButton.addEventListener('click', function(){
      if(window.innerWidth <= 958){
        openMobileFilters();
      } else {
        document
          .getElementById('stickyFilterContent')
          .classList
          .toggle('open');
      }
    });
  }

  const stickyDock = document.getElementById('stickyFilterDock');
  const collectionOptions = document.getElementById('shopify-section-collection-options');

  const updateStickyVisible = function(hide){
    collectionOptionsAtTop = hide;
    if(!stickyDock){
      return;
    }

    if(hide){
      stickyDock.classList.remove('visible');
    }
    else if(window.scrollY > scrollDownHeight){
      stickyDock.classList.add('visible');
    }
  };

  if(stickyDock && collectionOptions && 'IntersectionObserver' in window){
    const sentinel = document.createElement('div');
    sentinel.id = 'collectionOptionsScrollSentinel';
    sentinel.style.cssText = 'height:1px;width:1px;margin:0;padding:0;visibility:hidden;pointer-events:none;';
    collectionOptions.parentNode.insertBefore(sentinel, collectionOptions);

    const observer = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        const hide = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        updateStickyVisible(hide);
      });
    }, { threshold: [0] });

    observer.observe(sentinel);

    const rect = sentinel.getBoundingClientRect();
    updateStickyVisible(rect.top < 0);
  }
});


</script>

