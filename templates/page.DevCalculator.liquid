function getUniqueForces(handle, actuators, stroke) {
  const uniqueForces = [];

  for (const actuator of actuators) {
    if (actuator.handle === handle && !uniqueForces.includes(actuator.Force) &&
      actuator.Stroke === stroke) {
      uniqueForces.push(actuator.Force);
    }
  }

  return uniqueForces;
}

function calculateArcIntersection(arc1, arc2, getBoth) {
  let intersectionFound = false;
  let bothIntersections = [];
  let distanceBetweenCenter = dist(arc1.x, arc1.y, arc2.x, arc2.y);
  let angle = atan2(arc2.y - arc1.y, arc2.x - arc1.x);
  let d = (arc1.radius**2 - arc2.radius**2 + distanceBetweenCenter**2) / (2 * distanceBetweenCenter);
  let x = arc1.x + d * cos(angle);
  let y = arc1.y + d * sin(angle);
  let distanceBetweenIntersect;

  if (distanceBetweenCenter < (arc1.radius + arc2.radius)) {
      let h = sqrt(arc1.radius**2 - d**2);
      intersectedPointOne = [x + h*cos(angle + HALF_PI), y + h*sin(angle + HALF_PI)];
      intersectedPointTwo = [x - h*cos(angle + HALF_PI), y - h*sin(angle + HALF_PI)];
      if (arc1.contains(x + h*cos(angle + HALF_PI), y + h*sin(angle + HALF_PI)) && (x + h*cos(angle + HALF_PI)) < lineX2 && (y + h*sin(angle + HALF_PI) < canvasHeight-100) && arc2.contains(x + h*cos(angle + HALF_PI), y + h*sin(angle + HALF_PI))) {
        distanceBetweenIntersect = dist(x + h*cos(angle + HALF_PI), y + h*sin(angle + HALF_PI), lidCircleX, lidCircleY);
        if(!getBoth){
          return [x + h*cos(angle + HALF_PI), y + h*sin(angle + HALF_PI)];
        }
        bothIntersections.push([x + h * Math.cos(angle + HALF_PI), y + h * Math.sin(angle + HALF_PI)]);
      }

      if (arc1.contains(x - h*cos(angle + HALF_PI), y - h*sin(angle + HALF_PI)) && (x - h*cos(angle + HALF_PI)) > lineX1 && (y - h*sin(angle + HALF_PI) < canvasHeight-100) && arc2.contains(x + h*cos(angle + HALF_PI), y + h*sin(angle + HALF_PI))) {
        distanceBetweenIntersect = dist(x - h*cos(angle + HALF_PI), y - h*sin(angle + HALF_PI), lidCircleX, lidCircleY);
        if(!getBoth){
          return [x - h*cos(angle + HALF_PI), y - h*sin(angle + HALF_PI)];
        }
        bothIntersections.push([x - h * Math.cos(angle + HALF_PI), y - h * Math.sin(angle + HALF_PI)]);
      }

      if(getBoth && bothIntersections.length >= 1){
        return bothIntersections;
      }
  }
  return false;
}

function drawActuator(intersections, actuator){
  let topMidpointX = intersections[0];
  let topMidpointY = intersections[1];

  let bottomMidpointX = lidCircleX;
  let bottomMidpointY = lidCircleY;

  
  let angleRadians = atan2(topMidpointY - bottomMidpointY, topMidpointX - bottomMidpointX);
  if(actuator == 1){
    actuatorAngle = degrees(angleRadians);
  }
  else if(actuator == 1){
    actuatorAngle2 = degrees(angleRadians);
  }


  let strokeStartX = topMidpointX + ((actuatorLength/(actuatorLength+actuatorStroke)) * (bottomMidpointX - topMidpointX));
  let strokeStartY = topMidpointY + ((actuatorLength/(actuatorLength+actuatorStroke)) * (bottomMidpointY - topMidpointY));

  // Calculate angle between midpoints
  let angle = atan2(bottomMidpointY - topMidpointY, bottomMidpointX - topMidpointX);

  // Calculate the offsets for the rectangle corners
  let xOffset = 3 * cos(angle + PI/2);
  let yOffset = 3 * sin(angle + PI/2);

  // Calculate the four corner points of the rectangle
  corner1X = topMidpointX + xOffset;
  corner1Y = topMidpointY + yOffset;
  corner2X = topMidpointX - xOffset;
  corner2Y = topMidpointY - yOffset;
  corner3X = strokeStartX - xOffset;
  corner3Y = strokeStartY - yOffset;
  corner4X = strokeStartX + xOffset;
  corner4Y = strokeStartY + yOffset;

  xOffset = 1 * cos(angle + PI/2);
  yOffset = 1 * sin(angle + PI/2);

  corner7X = strokeStartX - xOffset;
  corner7Y = strokeStartY - yOffset;
  corner8X = strokeStartX + xOffset;
  corner8Y = strokeStartY + yOffset;
  corner5X = bottomMidpointX + xOffset;
  corner5Y = bottomMidpointY + yOffset;
  corner6X = bottomMidpointX - xOffset;
  corner6Y = bottomMidpointY - yOffset;

  //rod
  stroke('#6f78bf');
  fill('#6f78bf');
  beginShape();
  vertex(corner5X, corner5Y);
  vertex(corner6X, corner6Y);
  vertex(corner7X, corner7Y);
  vertex(corner8X, corner8Y);
  endShape(CLOSE);

  //body
  fill('#3642b3');
  stroke('#3642b3');
  beginShape();
  vertex(corner1X, corner1Y);
  vertex(corner2X, corner2Y);
  vertex(corner3X, corner3Y);
  vertex(corner4X, corner4Y);
  endShape(CLOSE);
  actuatorPoints(intersections);
}

function actuatorPoints(intersections){
  point(lidCircleX, lidCircleY);
  point(intersections[0], intersections[1]);
  stroke('#ff8800');
  fill('#ff8800');
  strokeWeight(4);
  //lid
  ellipse(lidCircleX, lidCircleY, 15); 
  //box
  ellipse(intersections[0], intersections[1], 15); 
}

