function canvasPointToHingeInches(xPoint, yPoint){
  const lidLength = Math.max(0.001, parseFloat(document.getElementById('inputValueTwo').value) || 0.001);
  const boxHeightInches = Math.max(0.001, parseFloat(document.getElementById('inputValueOne').value) || 0.001);
  const xScale = lineX2 - lineX1;
  const yScale = canvasHeight - 100 - lineY1;
  return {
    x: xScale ? ((xPoint - lineX1) / xScale) * lidLength : 0,
    y: yScale ? ((yPoint - lineY1) / yScale) * boxHeightInches : 0
  };
}

function forceForMountAtAngle(angleDeg, xPoint, yPoint){
  const lidLength = Math.max(0.001, parseFloat(document.getElementById('inputValueTwo').value) || 0.001);
  const lidWeight = Math.max(0, parseFloat(document.getElementById('inputValueThree').value) || 0);
  const mountDistance = lidLength * ((parseFloat(circleSliderTwo.value) || 0) / 100);
  if (mountDistance <= 0 || lidWeight <= 0) return 0;

  const base = canvasPointToHingeInches(xPoint, yPoint);
  const angleRadians = angleDeg * Math.PI / 180;
  const lidMountX = mountDistance * Math.cos(angleRadians);
  const lidMountY = -mountDistance * Math.sin(angleRadians);
  const actuatorDX = lidMountX - base.x;
  const actuatorDY = lidMountY - base.y;
  const actuatorLength = Math.sqrt(actuatorDX * actuatorDX + actuatorDY * actuatorDY);
  if (actuatorLength <= 0.001) return 999999999;

  const actuatorUX = actuatorDX / actuatorLength;
  const actuatorUY = actuatorDY / actuatorLength;
  const momentArm = Math.abs(lidMountX * actuatorUY - lidMountY * actuatorUX);
  if (momentArm <= 0.001) return 999999999;

  const lidTorque = Math.abs(lidWeight * (lidLength / 2) * Math.cos(angleRadians));
  return (lidTorque / momentArm) * 1.2;
}

function findMaxForce(){
  const lidAngle = Math.max(0, Math.min(180, parseFloat(document.getElementById('angleSlider').value) || 0));
  let largestForces = 0;
  let largestForcesTwo = 0;
  for (let i = 0; i <= lidAngle; i++) {
    const totalForceRequired = forceForMountAtAngle(i, actuatorMountingPointOne[0], actuatorMountingPointOne[1]);
    if (largestForces < totalForceRequired) largestForces = totalForceRequired;
    if (actuatorMountingPointTwo) {
      const totalForceRequiredTwo = forceForMountAtAngle(i, actuatorMountingPointTwo[0], actuatorMountingPointTwo[1]);
      if (largestForcesTwo < totalForceRequiredTwo) largestForcesTwo = totalForceRequiredTwo;
    }
  }
  if (actuatorMountingPointTwo) return [largestForces, largestForcesTwo];
  return [largestForces, 999999999];
}

function calculateActuatorAngle(angle, xPoint, yPoint){
  const lidLength = Math.max(0.001, parseFloat(document.getElementById('inputValueTwo').value) || 0.001);
  const mountDistance = lidLength * ((parseFloat(circleSliderTwo.value) || 0) / 100);
  const base = canvasPointToHingeInches(xPoint, yPoint);
  const angleRadians = angle * Math.PI / 180;
  const lidMountX = mountDistance * Math.cos(angleRadians);
  const lidMountY = -mountDistance * Math.sin(angleRadians);
  const lidUX = Math.cos(angleRadians);
  const lidUY = -Math.sin(angleRadians);
  const actuatorDX = lidMountX - base.x;
  const actuatorDY = lidMountY - base.y;
  const actuatorLength = Math.sqrt(actuatorDX * actuatorDX + actuatorDY * actuatorDY);
  if (actuatorLength <= 0.001) return 0;
  const actuatorUX = actuatorDX / actuatorLength;
  const actuatorUY = actuatorDY / actuatorLength;
  const cross = Math.abs(lidUX * actuatorUY - lidUY * actuatorUX);
  const dot = Math.max(-1, Math.min(1, lidUX * actuatorUX + lidUY * actuatorUY));
  return Math.atan2(cross, dot) * 180 / Math.PI;
}

function addAcuatorStrokes(handle, name, currentStroke){
  removeAllOptions();
  let matchedStroke = false;
  const uniqueStrokes = new Set();
  for (const actuator of actuatorDimensions) {
    if (actuator.handle === handle) {
      uniqueStrokes.add(actuator.Stroke);
    }
  }
  addOption('default', 'Choose Stroke');
  uniqueStrokes.forEach((stroke) => {
    let option = addOption(stroke, name + " " + stroke + '"');
    if (stroke === currentStroke) {
      option.setAttribute('selected', 'selected');
      matchedStroke = true;
    }
  });
  if(!matchedStroke){
    selectElement.querySelector("option").selected = true;
  }
  updateSelectorHighlights();
  syncSelectionAnimations();
}

const selectElement = document.getElementById("actuatorStrokeSelector");
function addOption(value, text) {
  const option = document.createElement("option");
  option.value = value;
  option.text = text;
  selectElement.appendChild(option);
  return option;
}

// Function to remove all options from the select element
function removeAllOptions() {
  selectElement.innerHTML = "";
}
function updateSelectorHighlights() {
  document.getElementById("actuatorTypeSelector").classList.toggle(
    "needs-selection",
    document.getElementById("actuatorTypeSelector").value === "default"
  );

  document.getElementById("actuatorStrokeSelector").classList.toggle(
    "needs-selection",
    document.getElementById("actuatorStrokeSelector").value === "default"
  );
}
function syncSelectionAnimations() {
  document.querySelectorAll(".select").forEach(el => {
    el.style.animation = "none";
    el.offsetHeight; // Force reflow
    el.style.animation = "";
  });
}


