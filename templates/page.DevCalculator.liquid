function drawBox(){

  stroke("#88c6ef");
  strokeWeight(5);
  aspectRatio = (boxHeight/boxWidth);

  var maxHeight = 600;
  var maxWidth = 600;
  var amountToChange;
  var ratio = 1;

  if(boxWidth > boxHeight){
    newWidth = (squareEdgeWidth/aspectRatio);
    newHeight = newWidth*aspectRatio;
    
  }
  else if(boxWidth < boxHeight){
    newHeight = (squareEdgeWidth*aspectRatio);
    newWidth = newHeight/aspectRatio;
  }

  ratio = (newWidth + newHeight)/(squareEdgeWidth*2);
  newWidth = newWidth/ratio;
  newHeight = newHeight/ratio;

  if(boxWidth == boxHeight){
    newHeight = squareEdgeWidth;
    newWidth = squareEdgeWidth;
  }

  lineY1 = canvasWidth - newHeight - 100;
  lineY2 = canvasWidth - newHeight;
  lineX1 = (canvasWidth - newWidth) / 2;
  lineX2 = lineX1 + newWidth;


  stroke("#88c6ef");
  strokeWeight(4);


  //top line that height and width can move
  line(lineX1, lineY1, lineX2, lineY2-100);
  
  //bottom line that never moves up but can be squished
  line(lineX1,canvasHeight-100,lineX2,canvasHeight-100);

  //lines joining them:
  line(lineX1, canvasHeight-100, lineX1, lineY2-100);
  line(lineX2, lineY1, lineX2, canvasHeight-100);

  stroke("#0d90e8");
  strokeWeight(8);
  
  let angleRadians = radians(angleSlider.value);
  //400 is length of line

  angleX = cos(angleRadians) * newWidth;
  angleY = sin(angleRadians) * newWidth;

  line(lineX1, lineY1, lineX1 + angleX, lineY1 - angleY);

  //angle = slider.value();
}

function drawActuatorPoints(){
  lidCircleX = (lineX1 + lineX1 + angleX*(circleSliderTwo.value/50))/2;
  lidCircleY = (lineY1 + lineY1 - angleY*(circleSliderTwo.value/50))/2;
  stroke('#ff8800');
  fill('#ff8800');
  strokeWeight(4);
  //lid
  ellipse(lidCircleX, lidCircleY, 15); 
  //box
  ellipse(lineX1 + (lineX2 - lineX1)*(circleSliderTwo.value/100), lineY1, 10); 
  noFill();
}

function drawIntersectPoints(){
  strokeWeight(1);
  const selectElement = document.getElementById("actuatorTypeSelector");
  const options = selectElement.options;
  let solutionFound = false;
  let matchingStroke = false;
  for (let i = 0; i < actuatorDimensions.length; i++) {
    let currentActuator = actuatorDimensions[i];
    if(document.getElementById('manualInput').checked){
      if(currentActuator.Stroke != document.getElementById('actuatorStrokeSelector').value || currentActuator.handle != document.getElementById('actuatorTypeSelector').value){
        continue;
      }
    }
    matchingStroke = true;
    actuatorLength = currentActuator.retractedLength;
    actuatorStroke = currentActuator.Stroke;
    let arcFound = false;

    let arcLength = (((actuatorLength + actuatorStroke)/inputValueTwo.value)*newWidth);
    let boxArcLength = ((actuatorLength/inputValueTwo.value)*newWidth);
    
    let lidArc = {
    x: lidCircleX,
    y: lidCircleY,
    diameter: arcLength * 2,
    radius: arcLength,
    startAngle: radians(8) - radians(angleSlider.value),
    endAngle: radians(172) - radians(angleSlider.value),
    draw: function() {
        arc(this.x, this.y, this.diameter, this.diameter, this.startAngle, this.endAngle, PIE);
    },
    contains: function(x, y) {
        let distanceFromCenter = dist(x, y, this.x, this.y);
        if (distanceFromCenter > (this.radius * 1.001)) {
            return false;
        }
        let angle = atan2(y - this.y, x - this.x);
        let adjustedStartAngle = this.startAngle + radians(angleSlider.value);
        let adjustedEndAngle = this.endAngle + radians(angleSlider.value);
        
        // Normalize angles to be between 0 and TWO_PI
        while (adjustedStartAngle < 0) adjustedStartAngle += TWO_PI;
        while (adjustedStartAngle >= TWO_PI) adjustedStartAngle -= TWO_PI;
        while (adjustedEndAngle < 0) adjustedEndAngle += TWO_PI;
        while (adjustedEndAngle >= TWO_PI) adjustedEndAngle -= TWO_PI;
        
        // Normalize angle to be between 0 and TWO_PI
        while (angle < 0) angle += TWO_PI;
        while (angle >= TWO_PI) angle -= TWO_PI;

        // Check if the angle falls within the adjusted range
        if (adjustedEndAngle > adjustedStartAngle) {
            return (angle >= adjustedStartAngle && angle <= adjustedEndAngle);
        } else {
            return (angle >= adjustedStartAngle || angle <= adjustedEndAngle);
        }
    }
};

    let boxArc = {
      x: lineX1 + (lineX2 - lineX1) * (circleSliderTwo.value / 100),
      y: lineY1,
      diameter: boxArcLength*2,
      radius: boxArcLength,
      startAngle: radians(16),
      endAngle: radians(166),
      draw: function() {
        arc(this.x, this.y, this.diameter, this.diameter, this.startAngle, this.endAngle, PIE);
      },
      contains: function(x, y) {
        let distanceFromCenter = dist(x, y, this.x, this.y);
        if (distanceFromCenter > (this.radius*1.001)) {
          return false;
        }
        let angle = atan2(y - this.y, x - this.x);
        while (angle < this.startAngle) angle += TWO_PI;
        while (angle > this.endAngle) angle -= TWO_PI;
        return (angle >= this.startAngle && angle <= this.endAngle);
      }
    };

    if(document.getElementById('manualInput').checked){
      strokeWeight(2);
      stroke('#ff8800');
      boxArc.draw();
      stroke('#ffc800');
      lidArc.draw();
      addAcuatorStrokes(currentActuator.handle, actuatorNames.get(currentActuator.handle), currentActuator.Stroke);
    }
    let intersections;
    actuatorMountingPointOne = null;
    actuatorMountingPointTwo = null;
    intersections = calculateArcIntersection(boxArc, lidArc, true);

    if(intersections){
      
      strokeWeight(2);
      stroke('#ff8800');
      uniqueForces = getUniqueForces(currentActuator.handle, actuatorDimensions, currentActuator.Stroke);
      
      if(intersections[0]){
        actuatorMountingPointOne = [intersections[0][0], intersections[0][1]];
      }
      if(intersections[1]){
        actuatorMountingPointTwo = [intersections[1][0], intersections[1][1]];
      }
      let minForce = findMaxForce();
      //*2 as we are calculating for 2 actuators.
      if(Math.min(minForce[0], minForce[1]) < Math.max(...uniqueForces)*getSelectedActuatorCount() || document.getElementById('manualInput').checked){
        solutionFound = true;
        if(!document.getElementById('manualInput').checked){
          boxArc.draw();
          stroke('#ffc800');
          lidArc.draw();
        }
        stroke('#000000');
        strokeWeight(5);
        //point(intersections[0], intersections[1]);
        strokeWeight(1);
        textSize(36);
        stroke('#3642b3');
        fill('#3642b3');
        if(document.getElementById('alternativeNo').checked && intersections[0]){
          if(minForce[0] <= minForce[1]){
            //console.log("First option");
            text("A", intersections[0][0] + 8, intersections[0][1] + 22);
            strokeWeight(5);
            drawActuator(intersections[0], 1);
          }
          else{
            //console.log("Second option");
            text("A", intersections[1][0] + 8, intersections[1][1] + 22);
            strokeWeight(5);
            drawActuator(intersections[1], 1);
          }
          noFill();
        }
        else{
          if(intersections[0]){
            if(minForce[0] <= minForce[1]){
              text("A", intersections[0][0] + 8, intersections[0][1] + 22);
              strokeWeight(5);
              drawActuator(intersections[0], 1);
            }
            else{
              text("A", intersections[1][0] + 8, intersections[1][1] + 22);
              strokeWeight(5);
              drawActuator(intersections[1], 1);
            }
            noFill();
          }
          if(intersections[1]){
            strokeWeight(1);
            textSize(36);
            stroke('#3642b3');
            fill('#3642b3');
            if(minForce[0] <= minForce[1]){
              text("B", intersections[1][0] + 8, intersections[1][1] + 22);
              strokeWeight(5);
              drawActuator(intersections[1], 2);
            }
            else{
              text("B", intersections[0][0] + 8, intersections[0][1] + 22);
              strokeWeight(5);
              drawActuator(intersections[0], 2);
            }
            noFill();
          }
        }
        noFill();
        for (let i = 0; i < options.length; i++) {
          if (options[i].text === actuatorNames.get(currentActuator.handle)) {
            options[i].selected = true;
            break;
          }
        }
        if(!document.getElementById('manualInput').checked){
          addAcuatorStrokes(currentActuator.handle, actuatorNames.get(currentActuator.handle), currentActuator.Stroke);
        }
        document.getElementById('actuatorResults').innerHTML = actuatorNames.get(currentActuator.handle) + " " + currentActuator.Stroke + '"';
        if(!document.getElementById('alternativeNo').checked){
          if(intersections[0]){
            var XIntersectOne;
            var yIntersectOne;
            if(minForce[0] <= minForce[1]){
              XIntersectOne = (((intersections[0][0] - lineX1) / (lineX2 - lineX1)) * document.getElementById('inputValueTwo').value).toFixed(2);
              yIntersectOne = (((intersections[0][1] - lineY1) / (canvasHeight-100-lineY1)) * document.getElementById('inputValueOne').value).toFixed(2);
            }
            else{
              XIntersectOne = (((intersections[1][0] - lineX1) / (lineX2 - lineX1)) * document.getElementById('inputValueTwo').value).toFixed(2);
              yIntersectOne = (((intersections[1][1] - lineY1) / (canvasHeight-100-lineY1)) * document.getElementById('inputValueOne').value).toFixed(2);
            }
            document.getElementById('XCoord').innerHTML = XIntersectOne + " Inches";
            document.getElementById('YCoord').innerHTML = yIntersectOne + " Inches";
          }
          if(intersections[1]){
            var XIntersectTwo;
            var yIntersectTwo;
            document.getElementById('secondResult').style.display = "block";
            if(minForce[0] <= minForce[1]){
              XIntersectTwo = (((intersections[1][0] - lineX1) / (lineX2 - lineX1)) * document.getElementById('inputValueTwo').value).toFixed(2);
              yIntersectTwo = (((intersections[1][1] - lineY1) / (canvasHeight-100-lineY1)) * document.getElementById('inputValueOne').value).toFixed(2);
            }
            else{
              XIntersectTwo = (((intersections[0][0] - lineX1) / (lineX2 - lineX1)) * document.getElementById('inputValueTwo').value).toFixed(2);
              yIntersectTwo = (((intersections[0][1] - lineY1) / (canvasHeight-100-lineY1)) * document.getElementById('inputValueOne').value).toFixed(2);
            }
            document.getElementById('XCoord2').innerHTML = XIntersectTwo + " Inches";
            document.getElementById('YCoord2').innerHTML = yIntersectTwo + " Inches";
          }
          else{
            document.getElementById('secondResult').style.display = "none";
          }

          //needs updating to show individual force for each actuator
          document.getElementById('forceResult').innerHTML = (Math.min(minForce[0], minForce[1])/getSelectedActuatorCount()).toFixed(2) + " Lbs";
          document.getElementById('forceResult2').innerHTML = (Math.max(minForce[0], minForce[1])/getSelectedActuatorCount()).toFixed(2) + " Lbs";
          document.getElementById('productImage').src = actuatorImage.get(currentActuator.handle);
          document.getElementById('productTitle').innerHTML = actuatorNames.get(currentActuator.handle) + " Linear Actuators";
          document.getElementById('productTitle').setAttribute('href', "https://www.firgelliauto.com/products/" + currentActuator.handle);
          document.getElementById('productPrice').innerHTML = actuatorPrice.get(currentActuator.handle);
          if(currentActuator.handle == 'utility-linear-actuators-110' || currentActuator.handle == 'utility-linear-actuators-330'){
            document.getElementById('buyNowButton').setAttribute('href', "https://www.firgelliauto.com/products/utility-linear-actuators");
          }
          else{
            document.getElementById('buyNowButton').setAttribute('href', "https://www.firgelliauto.com/products/" + currentActuator.handle);
          }
          break;
        }
        else{
          document.getElementById('secondResult').style.display = "none";
          var XIntersectOne;
          var yIntersectOne;
          if(minForce[0] <= minForce[1]){
            XIntersectOne = (((intersections[0][0] - lineX1) / (lineX2 - lineX1)) * document.getElementById('inputValueTwo').value).toFixed(2);
            yIntersectOne = (((intersections[0][1] - lineY1) / (canvasHeight-100-lineY1)) * document.getElementById('inputValueOne').value).toFixed(2);
          }
          else{
            XIntersectOne = (((intersections[1][0] - lineX1) / (lineX2 - lineX1)) * document.getElementById('inputValueTwo').value).toFixed(2);
            yIntersectOne = (((intersections[1][1] - lineY1) / (canvasHeight-100-lineY1)) * document.getElementById('inputValueOne').value).toFixed(2);
          }
          document.getElementById('XCoord').innerHTML = XIntersectOne + " Inches";
          document.getElementById('YCoord').innerHTML = yIntersectOne + " Inches";
          document.getElementById('forceResult').innerHTML = (Math.min(minForce[0], minForce[1])/getSelectedActuatorCount()).toFixed(2) + " Lbs";
          document.getElementById('productImage').src = actuatorImage.get(currentActuator.handle);
          document.getElementById('productTitle').innerHTML = actuatorNames.get(currentActuator.handle) + " Linear Actuators";
          document.getElementById('productTitle').setAttribute('href', "https://www.firgelliauto.com/products/" + currentActuator.handle);
          document.getElementById('productPrice').innerHTML = actuatorPrice.get(currentActuator.handle);
          if(currentActuator.handle == 'utility-linear-actuators-110' || currentActuator.handle == 'utility-linear-actuators-330'){
            document.getElementById('buyNowButton').setAttribute('href', "https://www.firgelliauto.com/products/utility-linear-actuators");
          }
          else{
            document.getElementById('buyNowButton').setAttribute('href', "https://www.firgelliauto.com/products/" + currentActuator.handle);
          }
          break;
        }
        
      }
    }
  }
  if(!matchingStroke){
    addAcuatorStrokes(document.getElementById('actuatorTypeSelector').value, actuatorNames.get(document.getElementById('actuatorTypeSelector').value), document.getElementById('actuatorStrokeSelector').value);
  }
  //show results
  if(!solutionFound){
    document.getElementById('mainResultsDiv').style.display = 'none';
    document.getElementById('XCoord').style.display = 'none';
    document.getElementById('YCoord').style.display = 'none';
    document.getElementById('actuatorResults').style.display = 'none';
    document.getElementById('forceResult').style.display = 'none';
    document.getElementById('forceResult2').style.display = 'none';
    document.getElementById('ForceWarning').style.display = 'none';
    document.getElementById('ForceWarning2').style.display = 'none';
    document.getElementById('secondResult').style.display = 'none';
  }
  else{
    document.getElementById('mainResultsDiv').style.display = 'block';
    document.getElementById('XCoord').style.display = 'contents';
    document.getElementById('YCoord').style.display = 'contents';
    document.getElementById('actuatorResults').style.display = 'block';
    document.getElementById('forceResult').style.display = 'block';
    document.getElementById('forceResult2').style.display = 'block';
    highlightForces();
  }
  if(!solutionFound && document.getElementById('autoInput').ticked){
    options[0].selected = true;
    document.getElementById('actuatorStrokeDiv').style.display = 'none';
  }
  else{
    document.getElementById('actuatorStrokeDiv').style.display = 'block';
  }
}

