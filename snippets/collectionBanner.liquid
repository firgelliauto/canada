{% assign collection_banner_css_handles = 'feedback-actuators,mini-linear-actuators' | split: ',' %}
{% if collection_banner_css_handles contains collection.handle %}
  {% capture collection_banner_css %}{{ collection.handle }}.css{% endcapture %}
  {{ collection_banner_css | asset_url | stylesheet_tag }}
{% endif %}

{% render 'actuatorBanner', collection: collection %}

{% assign actuator_collections = 'micro-motors,robotics,sit-stand-desks,drawer-slides,slide-rails,linear-actuators,linear-actuator-12v,24v-linear-actuators,ip66-linear-actuators,robotics-actuators,column-lifts,mini-linear-actuators,linear-actuators-classic-performance-enhanced-design,industrial-actuators,track-linear-actuators,feedback-actuators,rod-actuators,bullet-actuators,premium-linear-actuators,micro-linear-actuators' | split: ',' %}
{% if actuator_collections contains collection.handle %}
  <script>
    window.addEventListener('load', function () {
      var bannerScript = document.createElement('script');
      bannerScript.src = "{{ 'svg-banner-script.js' | asset_url }}";
      bannerScript.onload = function () {
        var animationScript = document.createElement('script');
        animationScript.src = "{{ 'svg-animation-script.js' | asset_url }}";
        animationScript.onload = function () {
          if (window.matchMedia('(max-width: 959px)').matches) return;
          function clearLottieShift() {
            var svg = document.querySelector('#lottie svg');
            if (!svg) return;
            svg.style.removeProperty('transform');
            svg.style.removeProperty('margin-top');
            svg.style.removeProperty('top');
          }
          clearLottieShift();
          setTimeout(clearLottieShift, 100);
          setTimeout(clearLottieShift, 400);
          setTimeout(clearLottieShift, 900);
        };
        document.body.appendChild(animationScript);
      };
      document.body.appendChild(bannerScript);
    });
  </script>
{% endif %}

{% if collection.handle == 'rotary-actuators' %}
