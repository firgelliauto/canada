<script>
(function () {
  function positionFirgelliCaBanner(attempt) {
    var banner = document.getElementById('fg-ca-rollout-banner');
    var header = document.querySelector('header.bannerHeight') || document.querySelector('header');
    if (banner && header && header.parentNode) {
      header.insertAdjacentElement('afterend', banner);
      document.documentElement.classList.add('fg-ca-banner-positioned');
      return;
    }
    if (attempt < 120) {
      window.requestAnimationFrame(function () { positionFirgelliCaBanner(attempt + 1); });
      return;
    }
    document.documentElement.classList.add('fg-ca-banner-positioned');
  }

  function loadFirgelliCaBanner() {
    if (document.documentElement.dataset.fgCaBannerLoaded === 'true') return;
    document.documentElement.dataset.fgCaBannerLoaded = 'true';
    var bannerScript = document.createElement('script');
    {% if fg_ca_rollout_profile == 'controls' %}
    bannerScript.src = "{{ 'svg-banner-script-controls.js' | asset_url }}";
    {% elsif fg_ca_rollout_profile == 'rotary' %}
    bannerScript.src = "{{ 'svg-banner-script-rotary.js' | asset_url }}";
    {% elsif fg_ca_rollout_profile == 'tv' %}
    bannerScript.src = "{{ 'svg-banner-script-tv-lifts.js' | asset_url }}";
    {% else %}
    bannerScript.src = "{{ 'svg-banner-script.js' | asset_url }}";
    {% endif %}
    bannerScript.onload = function () {
      var animationScript = document.createElement('script');
      {% if fg_ca_rollout_profile == 'controls' %}
      animationScript.src = "{{ 'svg-animation-script-controls.js' | asset_url }}";
      {% elsif fg_ca_rollout_profile == 'rotary' %}
      animationScript.src = "{{ 'svg-animation-script-rotary.js' | asset_url }}";
      {% elsif fg_ca_rollout_profile == 'tv' %}
      animationScript.src = "{{ 'svg-animation-script-tv-lifts.js' | asset_url }}";
      {% else %}
      animationScript.src = "{{ 'svg-animation-script.js' | asset_url }}";
      {% endif %}
      document.body.appendChild(animationScript);
    };
    document.body.appendChild(bannerScript);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { positionFirgelliCaBanner(0); }, { once: true });
  } else {
    positionFirgelliCaBanner(0);
  }
  if (document.readyState === 'complete') loadFirgelliCaBanner();
  else window.addEventListener('load', loadFirgelliCaBanner, { once: true });
})();
</script>
