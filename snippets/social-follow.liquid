{% assign fg_facebook_url = settings.facebook_link | default: 'https://www.facebook.com/FirgelliAuto' %}
{% assign fg_x_url = settings.twitter_link | default: 'https://x.com/FirgelliAuto' %}
{% assign fg_linkedin_url = settings.linkedin_link | default: 'https://www.linkedin.com/company/firgelli-automations' %}
<ul class="fg-social-icon-row" aria-label="FIRGELLI social links">
  <li>
    <a href="{{ fg_facebook_url }}" title="Facebook" aria-label="Follow FIRGELLI on Facebook" target="_blank" rel="noreferrer noopener" class="uk-icon-button fg-social-link" uk-icon="facebook"></a>
  </li>
  <li>
    <a href="{{ fg_x_url }}" title="X" aria-label="Follow FIRGELLI on X" target="_blank" rel="noreferrer noopener" class="uk-icon-button fg-social-link fg-social-link-x">
