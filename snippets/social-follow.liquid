    <a href="{{ fg_linkedin_url }}" title="LinkedIn" aria-label="Follow FIRGELLI on LinkedIn" target="_blank" rel="noreferrer noopener" class="uk-icon-button fg-social-link" uk-icon="linkedin"></a>
