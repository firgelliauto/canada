{%- capture responsive_image_counter %}{% increment responsive_image_counter %}{% endcapture -%}
{%- assign img_url = image | img_url: '400x400', crop: 'top' -%}

<div data-image-id="{{ image.id }}" class="responsive-image__wrapper {{ wrapper_class }}" {{ wrapper_attributes }}>
  <a class="js-fg-lightbox" href="{{ image | img_url: '1600x' }}">
    <img id="Image-{{ image.id }}-{{ responsive_image_counter }}"
         class="fg-responsive-image__image {{ image_class }} productOriginalImage"
         width="{{ image.width }}"
         height="{{ image.height }}"
         {% if forloop.first %}loading="eager" fetchpriority="high"{% endif %}
         src="{{ image | img_url: '400x400' }}"
         srcset="
             {{ image | img_url: '180x' }} 180w,
             {{ image | img_url: '360x' }} 360w,
             {{ image | img_url: '540x' }} 540w,
             {{ image | img_url: '700x' }} 700w,
             {{ image | img_url: '800x' }} 800w,
             {{ image | img_url: '960x' }} 960w,
             {{ image | img_url: '1024x' }} 1024w,
             {{ image | img_url: '1280x' }} 1280w,
             {{ image | img_url: '1366x' }} 1366w,
             {{ image | img_url: '1450x' }} 1450w,
             {{ image | img_url: '1600x' }} 1600w,
             {{ image | img_url: '1728x' }} 1728w,
             {{ image | img_url: '1944x' }} 1944w,
             {{ image | img_url: '2160x' }} 2160w,
             {{ image | img_url: '2376x' }} 2376w,
             {{ image | img_url: '2592x' }} 2592w,
             {{ image | img_url: '2808x' }} 2808w,
             {{ image | img_url: '3024x' }} 3024w"
         sizes="(max-width: 600px) 100vw, 50vw"
         data-aspectratio="{{ image.aspect_ratio }}"
         alt="{{ image.alt | escape }}"
         title="{{ image.alt | escape }}"
         {{ image_attributes }}>
  </a>
</div>
