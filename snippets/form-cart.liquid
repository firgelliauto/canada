<style>
  .itemHidden{
    display: none !important;
  }
  .itemAtMaxQuantity{
    opacity: 0.1;
  }
  .stockWarningMessageMobile{
    max-width: 204px;
    margin-top: 5px;
  }
  .stockWarningMessage{
   margin-top: 10px;
  }
  .stockMessageHidden{
    display: none !important;
  }
  input.fg-cart-quantity-toggle__text {
    width: 44px;
    height: 44px;
    box-sizing: border-box;
    text-align: center;
    border: 1px solid #0d90e8;
    border-radius: 0;
    background: transparent;
    color: #0d90e8;
    font: inherit;
    padding: 0;
    margin: 0;
    appearance: textfield;
  }
  input.fg-cart-quantity-toggle__text::-webkit-inner-spin-button,
  input.fg-cart-quantity-toggle__text::-webkit-outer-spin-button { appearance: none; }
  input.fg-cart-quantity-toggle__text:disabled {
    opacity: 1;
  }
  .fg-cart-quantity-status { color: #b42318; margin-top: 8px; }
  .fg-cart-discount-title,
  .fg-cart-savings .uk-animation-fade {
    animation: none !important;
  }
</style>
<script>
  window.firgelliCartMaxById = {
    {% for item in cart.items %}
      {{ item.id | json }}: {% if item.variant.inventory_management and item.variant.inventory_policy != 'continue' %}{{ item.variant.inventory_quantity | json }}{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };
</script>
{{ 'fg-cart-quantity.js' | asset_url | script_tag }}
<div class="js-logo-animate fg-logo-loader-bg">  
  {% include 'icon-logo-firgelli_animate' %}
</div>
<form class="js-cart-form fg-transparent" style="display: none;" action="{{ routes.cart_url }}" method="post" novalidate data-cart-view="data-cart-view">
  <div class="uk-section">
    <div class="uk-container">
      <div class="fg-cart-heading">
        <h1>{{ settings.cart_page_heading }}</h1>
        <div class="fg-cart-button-group uk-grid-small" uk-grid>
          <div>
            <a href="{{ routes.root_url }}" class="fg-button-default uk-button uk-visible@s">
              <span uk-icon="icon:chevron-left"></span>
              Continue Shopping
            </a>
          </div>
          <div>
            <a href="#fg-order-summer-anchor" class="fg-button-default fg-arrow-down-hover uk-button" uk-scroll="duration: 400; offset: 160" uk-icon="icon:chevron-down; ratio: 1.2">
              Order Summary
            </a>
          </div>
        </div>
      </div>
      <table class="fg-cart-table uk-table uk-table-divider uk-table-responsive">
        <thead>
          <tr>
            <th colspan="2"><span class="uk-h4">Item</span></th>
            <th><span class="uk-h4">Price</span></th>
            <th><span class="uk-h4">Quantity</span></th>
            <th><span class="uk-h4">Total Price</span></th>
          </tr>
        </thead>
        <tbody>
          <tr class="fg-cart-table__tr" rv-each-item="cart.items" rv-data-cart-key="item.key">
            <td class="fg-cart-table__image fg-cart-table__td-first">
              <div class="fg-cart-table__image-container">
                <img class="uk-margin-right" rv-src="item.image | productImageSize 'small'" />
                <a class="uk-display-block uk-visible@s" rv-href="item.url">See Item</a>
              </div>
              <div class="fg-cart-table__td-show-s">
                <div class="fg-cart-table___td-show-s_title">
                  <strong class="fg-cart-item__title-s uk-h5 uk-margin-remove itemName" rv-text="item.title"></strong>
                  <a class="js-cart-remove-line_item uk-text-danger" href="#" uk-tooltip="title: Are you sure that you want to remove this item?; pos: bottom-left"> remove</a>
                </div>
                <div rv-hide="item.propertyArray | empty">
                  <span rv-each-property="item.propertyArray < properties">
                    <small class="text-muted">{property.name}: {property.value}</small>
                  </span>
                </div>
                <div class="fg-cart-table___td-show-s_price">
                  <span class="fg-cart-unit-regular uk-text-meta">Item Price <var class="fg-cart-unit-original"></var> <span class="uk-text-meta">{{ shop.currency }}</span></span>
                  <span class="fg-cart-unit-discount uk-text-meta" hidden>Discount Price <var class="fg-cart-unit-final"></var> <span class="uk-text-meta">{{ shop.currency }}</span><br>Original Price <s><var class="fg-cart-unit-original"></var> <span class="uk-text-meta">{{ shop.currency }}</span></s></span>
                  <div class="fg-cart-server-discounts" hidden>
                    <span class="uk-alert-primary uk-animation-fade uk-text-primary fg-cart-discount-title"></span>
                  </div>
                </div>
                <div class="fg-cart-table___td-show-s_total-price">
                  <strong class="fg-responsive-th">Total Price</strong>
                  <strong><var class="totalItemPrice" rv-html="item.line_price | money Currency.currentCurrency"></var> <span>{{ shop.currency }}</span></strong>
                  <div class="fg-cart-savings" hidden>
                    <span class="uk-alert-primary uk-animation-fade uk-text-primary savedAmount">Save <var></var> <span class="uk-text-small uk-text-primary">{{ shop.currency }}</span></span>
                  </div>
                </div>
                <a class="uk-display-block uk-hidden@s" rv-href="item.url">See Item</a>
                <span class="fg-alert js-warning-cart-limit uk-animation-slide-top-small uk-alert-warning uk-display-block stockWarningMessageMobile stockMessageHidden"></span>
              </div>
            </td>
            <td class="uk-flex uk-flex-middle fg-cart-table__title fg-cart-table__td-show-l">
              <strong class="uk-h5 uk-margin-remove" rv-text="item.title"></strong>
              <a class="js-cart-remove-line_item uk-text-danger" href="#" uk-tooltip="title: Are you sure that you want to remove this item?; pos: bottom-left"> remove</a>
              <span class="fg-alert js-warning-cart-limit uk-animation-slide-top-small uk-alert-warning uk-display-block stockWarningMessage stockMessageHidden"></span>
              <div rv-hide="item.propertyArray | empty">
                <span rv-each-property="item.propertyArray < properties">
                  <small class="text-muted">{property.name}: {property.value}</small>
                </span>
              </div>
            </td>
            <td class="fg-cart-table__price fg-cart-table__td-show-l">
              <div class="fg-cart-unit-regular"><var class="itemPrice fg-cart-unit-original"></var> <span class="uk-text-small">{{ shop.currency }}</span></div>
              <div class="fg-cart-unit-discount" hidden>
                <span>Discount Price <var class="fg-cart-unit-final"></var> <span class="uk-text-small">{{ shop.currency }}</span></span>
                <br>
                <span>Original Price <s><var class="fg-cart-unit-original"></var> <span class="uk-text-small">{{ shop.currency }}</span></s></span>
              </div>
              <div class="fg-cart-server-discounts" hidden>
                <span class="uk-alert-primary uk-animation-fade uk-text-primary fg-cart-discount-title"></span>
              </div>
            </td>
            <td class="fg-cart-table__quantity">
              <div class="fg-cart-table__quantity-toggle">
                <a class="js-cart-quanity-toggle fg-cart-quantity-toggle__minus" href="#" aria-label="Decrease quantity"><span class="fg-svg-reset" uk-icon="minus"></span></a>
                <input class="js-cart-item-quantity fg-cart-quantity-toggle__text" type="number" min="0" step="1" inputmode="numeric" aria-label="Quantity" />
                <a class="js-cart-quanity-toggle fg-cart-quantity-toggle__plus" href="#" aria-label="Increase quantity"><span class="fg-svg-reset" uk-icon="plus"></span></a>
              </div>
            </td>
            <td class="fg-cart-table__total-price fg-cart-table__td-show-l">
              <span class="fg-responsive-th">Total Price</span>
              <span><var class="individualPrice" rv-html="item.line_price | money Currency.currentCurrency"></var> <span class="uk-text-small">{{ shop.currency }}</span></span>
              <div class="fg-cart-savings" hidden>
                <span class="uk-alert-primary uk-animation-fade uk-text-primary savedAmount">Save <var></var> <span class="uk-text-small uk-text-primary">{{ shop.currency }}</span></span>
              </div>
            </td>
          </tr>
          <tr class="fg-cart-empty-row" rv-show="cart.item_count | lt 1">
            <td colspan="5">You don't have any items in your cart.</td>
          </tr>
        </tbody>
      </table>
      <a href="{{ routes.root_url }}" class="fg-button-default uk-button uk-visible@s">
        <span uk-icon="icon:chevron-left"></span>
        Continue Shopping
      </a>
    </div>
  </div>
  {% include 'form-cart-footer' %}
</form>
<p class="fg-cart-quantity-status uk-container" role="alert" hidden></p>
